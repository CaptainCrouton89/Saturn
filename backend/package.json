{
  "name": "saturn-backend",
  "version": "1.0.0",
  "description": "Backend API for Cosmo AI Companion",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "db:pull": "mkdir -p src/types && supabase gen types typescript --local > src/types/database.types.ts",
    "db:reset-neo4j": "node scripts/reset-neo4j.js",
    "mcp": "tsx src/mcp.ts",
    "prepare": "husky"
  },
  "keywords": [
    "express",
    "typescript",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@langfuse/client": "^4.4.2",
    "@langfuse/otel": "^5.11.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@neo4j/graphql": "^7.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@r-cli/sdk": "^1.1.115",
    "@supabase/supabase-js": "^2.80.0",
    "@toon-format/toon": "^1.0.0",
    "ai": "^6.0.116",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "natural": "^8.1.0",
    "neo4j-driver": "^6.0.1",
    "openai": "^6.32.0",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "tiktoken": "^1.0.22",
    "umap-js": "^1.4.0",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/natural": "^6.0.1",
    "@types/node": "^22.10.5",
    "@types/uuid": "^11.0.0",
    "@vitest/ui": "^2.1.8",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
